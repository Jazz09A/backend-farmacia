# Ejemplo de variables de entorno del backend (copiar a .env)
# Config mínima para desarrollo local (caché en memoria, sin Redis).

# Base de datos
DATABASE_URL=sqlite:///./db.sqlite3

# Seguridad
SECRET_KEY=cambia-esta-clave-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (origen del frontend)
ALLOWED_ORIGINS=http://localhost:5173

# Caché (Redis)
# 'memory' para desarrollo/CI, 'redis' para producción.
CACHE_DRIVER=memory
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_KEY_PREFIX=farmacia:cache:
CACHE_REDIS_HEALTH_INTERVAL=30
